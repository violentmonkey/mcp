{
  "name": "@violentmonkey/mcp-client",
  "version": "0.1.1",
  "description": "Lightweight client for connecting Violentmonkey to @violentmonkey/mcp",
  "keywords": [
    "violentmonkey",
    "userscript",
    "mcp",
    "model-context-protocol"
  ],
  "homepage": "https://github.com/violentmonkey/mcp#readme",
  "bugs": {
    "url": "https://github.com/violentmonkey/mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/violentmonkey/mcp.git",
    "directory": "packages/client"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@violentmonkey/mcp-protocol": "workspace:*"
  }
}
