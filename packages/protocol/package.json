{
  "name": "@violentmonkey/mcp-protocol",
  "version": "0.0.0",
  "description": "Wire protocol constants, types and schemas for Violentmonkey MCP",
  "keywords": [
    "violentmonkey",
    "userscript",
    "mcp",
    "model-context-protocol"
  ],
  "homepage": "https://github.com/violentmonkey/mcp#readme",
  "bugs": {
    "url": "https://github.com/violentmonkey/mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/violentmonkey/mcp.git",
    "directory": "packages/protocol"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "^4.0.0"
  }
}
