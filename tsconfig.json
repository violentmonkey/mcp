{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@violentmonkey/mcp-protocol": ["./packages/protocol/src/index.ts"],
      "@violentmonkey/mcp-protocol/schemas": ["./packages/protocol/src/schemas.ts"],
      "@violentmonkey/mcp-client": ["./packages/client/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "vitest.config.ts", "packages/*/vite.config.ts"]
}
